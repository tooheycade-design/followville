# Phase 0 does not require credentials.
# Keep API spending disabled until an owner approves a non-zero budget.
COMPANY_OS_MODE=simulation
COMPANY_OS_MONTHLY_BUDGET_USD_MICROS=0

# Planned Phase 1 server-only settings. Never prefix secrets with NEXT_PUBLIC_.
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=

# Planned provider adapters. Do not add values to this file.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
